# =============================================================================
# COLI237 Backend — Variables d'environnement de PRODUCTION
# =============================================================================

# --- Environnement ---
NODE_ENV=production
PORT=3000

# --- URLs publiques ---
# L'API est servie sous /api derriere le reverse proxy.
API_BASE_URL=https://onboard.coli237.com/api
WEB_BASE_URL=https://onboard.coli237.com
# Origines autorisees pour CORS (separees par des virgules si plusieurs).
CORS_ORIGINS=https://onboard.coli237.com

# --- Securite JWT ---
# Generer une valeur forte (au moins 32 caracteres) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Base de donnees ---
# En prod avec Postgres conteneurise, l'hote est le nom du service Docker
# (souvent "postgres"), pas localhost. Adaptez selon le docker-compose du
# collaborateur. Exemple :
#   postgresql://<user>:<motdepasse>@postgres:5432/<base>?schema=public
DATABASE_URL=

# --- Stockage des fichiers (Supabase) ---
# Utilise pour les documents uploades (CNI, permis...). La cle service_role
# est SECRETE et ne doit exister que cote serveur.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- SMS / verification (Twilio) — optionnel ---
# A remplir seulement si l'envoi de SMS est active. Sinon, laisser vide.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VERIFY_SID=

# --- Premier admin (script d'amorçage) ---
# Lu par le seed, pas par l'app. Necessaire au premier demarrage.
ADMIN_EMAIL=admin@coli237.com
ADMIN_TELEPHONE=650891348
ADMIN_MOT_DE_PASSE=Is@@c3than1
