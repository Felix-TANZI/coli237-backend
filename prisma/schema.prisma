// ---------------------------------------------------------------------------
// COLI237 — Plateforme de recensement des livreurs
// Espace Agent + Espace Admin. PostgreSQL 16.
// ---------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// AGENT — personne de terrain qui recense. Cree par l'admin.
// (Compte de connexion a la plateforme : AGENT ou ADMIN.)
// ===========================================================================
model Agent {
  id String @id @default(uuid()) @db.Uuid

  nom        String @db.VarChar(120)
  telephone  String @unique @db.VarChar(20)
  email      String @unique @db.VarChar(160)
  motDePasse String @map("mot_de_passe") @db.VarChar(255)

  role RoleAgent @default(AGENT)

  // Vrai a la creation : l'agent doit changer son mot de passe
  // a la premiere connexion.
  doitChangerMotDePasse Boolean @default(true) @map("doit_changer_mot_de_passe")

  statut     StatutCompte @default(ACTIF)
  supprimeLe DateTime?    @map("supprime_le")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  personnes Personne[]

  @@index([statut])
  @@index([role])
  @@map("agents")
}

// ===========================================================================
// COMPAGNIE — entreprise de livraison.
// Un livreur agence y est rattache.
// ===========================================================================
model Compagnie {
  id String @id @default(uuid()) @db.Uuid

  nom    String @db.VarChar(160)
  statut String @default("ACTIVE") @db.VarChar(20)

  supprimeLe DateTime? @map("supprime_le")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  personnes Personne[]

  @@index([supprimeLe])
  @@map("compagnies")
}

// ===========================================================================
// PERSONNE — individu recense par un agent (4 roles possibles).
// Ce ne sont PAS des comptes de connexion : ce sont des donnees.
// Champs communs a tous + champs specifiques selon le role.
//   ADMIN_COMPAGNIE      : identite seule
//   MANAGER_AGENCE       : identite seule
//   LIVREUR_INDEPENDANT  : identite + vehicule + documents
//   LIVREUR_AGENCE       : identite + vehicule + compagnie + statut chauffeur
// ===========================================================================
model Personne {
  id String @id @default(uuid()) @db.Uuid

  role   RolePersonne
  statut StatutValidation @default(EN_ATTENTE)

  // Identite (commun a tous les roles)
  prenom    String  @db.VarChar(80)
  nom       String  @db.VarChar(120)
  email     String? @db.VarChar(160)
  telephone String  @db.VarChar(20)
  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  // Localisation (livreurs surtout)
  ville     String? @db.VarChar(80)
  quartier  String? @db.VarChar(120)
  latitude  Float?
  longitude Float?

  // Vehicule (livreur independant + livreur agence)
  typeVehicule      TypeVehicule? @map("type_vehicule")
  typeVehiculeAutre String?       @map("type_vehicule_autre") @db.VarChar(80)
  plaque            String?       @db.VarChar(20)

  // Specifique livreur agence
  compagnieId     String? @map("compagnie_id") @db.Uuid
  statutChauffeur String? @map("statut_chauffeur") @db.VarChar(20)

  // Paiement (livreurs)
  mobileMoneyNumero    String?               @map("mobile_money_numero") @db.VarChar(20)
  mobileMoneyOperateur OperateurMobileMoney? @map("mobile_money_operateur")

  // Tracabilite
  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  compagnie Compagnie? @relation(fields: [compagnieId], references: [id], onDelete: SetNull)

  supprimeLe DateTime? @map("supprime_le")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  documents PieceJointe[]

  @@index([role])
  @@index([statut])
  @@index([agentId])
  @@index([compagnieId])
  @@index([ville])
  @@index([supprimeLe])
  @@map("personnes")
}

// ===========================================================================
// PIECE JOINTE — photo ou document, rattache a une personne.
// ===========================================================================
model PieceJointe {
  id String @id @default(uuid()) @db.Uuid

  type        TypePieceJointe
  chemin      String  @db.VarChar(500) // chemin du fichier stocke
  nomOriginal String? @map("nom_original") @db.VarChar(255)

  personneId String   @map("personne_id") @db.Uuid
  personne   Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([personneId])
  @@map("pieces_jointes")
}

// ===========================================================================
// ENUMS
// ===========================================================================
enum RolePersonne {
  ADMIN_COMPAGNIE
  MANAGER_AGENCE
  LIVREUR_INDEPENDANT
  LIVREUR_AGENCE

  @@map("role_personne")
}

enum StatutCompte {
  ACTIF
  SUSPENDU

  @@map("statut_compte")
}

enum StatutValidation {
  EN_ATTENTE
  VALIDE
  REJETE

  @@map("statut_validation")
}

enum TypeVehicule {
  MOTO
  TRICYCLE
  VOITURE
  CAMIONNETTE
  A_PIED
  AUTRE

  @@map("type_vehicule")
}

enum OperateurMobileMoney {
  MTN
  ORANGE

  @@map("operateur_mobile_money")
}

enum TypePieceJointe {
  PHOTO_IDENTITE
  CNI
  PERMIS
  CARTE_GRISE
  ASSURANCE
  CARTE_SMT
  REGISTRE_COMMERCE
  AUTRE

  @@map("type_piece_jointe")
}

enum RoleAgent {
  AGENT
  ADMIN

  @@map("role_agent")
}
